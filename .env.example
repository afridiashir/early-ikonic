# SMTP — notification email for each signup (Gmail: use an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your app password
NOTIFY_EMAIL=where-signups-should-land@example.com

# Google Apps Script web app URL that appends a row per signup (optional)
SHEETS_WEBHOOK_URL=

# Registration counter shown on the page (defaults: 2847 / 5000)
EARLY_ACCESS_JOINED=2847
EARLY_ACCESS_GOAL=5000
